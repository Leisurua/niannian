NIANNIAN_HOST=REPLACE_WITH_KALI_LAN_IP
API_PORT=8000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
POSTGRES_DB=nianian
POSTGRES_USER=nianian
POSTGRES_PASSWORD=GENERATED_BY_DEPLOY_SCRIPT
MINIO_ROOT_USER=GENERATED_BY_DEPLOY_SCRIPT
MINIO_ROOT_PASSWORD=GENERATED_BY_DEPLOY_SCRIPT
AUTH_SIGNING_KEY=GENERATED_BY_DEPLOY_SCRIPT
CONTACT_ENCRYPTION_KEY=GENERATED_BY_DEPLOY_SCRIPT
# TLS deployment keeps these direct ports on loopback and publishes 443/9443 through nginx.
# API_BIND_ADDRESS=127.0.0.1
# MINIO_BIND_ADDRESS=127.0.0.1
# WORKER_HEARTBEAT_SECONDS=5
# WORKER_STALE_SECONDS=45
# Optional local semantic retrieval (rebuild after enabling):
# APP_ENV=dev
# EMBEDDING_PROVIDER=local
# PRELOAD_EMBEDDING_MODEL=true
# EMBEDDING_THREADS=2
# EMBEDDING_MIN_RELEVANCE=0.5
# External delivery requires APP_ENV=dev and private credentials.
# NOTIFICATION_EXTERNAL_ENABLED=false
# NOTIFICATION_PUSH_PROVIDER=mock
# NTFY_BASE_URL=https://your-private-ntfy.example
# PUSH_API_KEY=configure-in-local-env-only
# TWILIO_ACCOUNT_SID=configure-in-local-env-only
# TWILIO_AUTH_TOKEN=configure-in-local-env-only
# TWILIO_FROM_NUMBER=configure-in-local-env-only
# TWILIO_STATUS_CALLBACK_URL=https://api.example/v1/notification-webhooks/twilio
