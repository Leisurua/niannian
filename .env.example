# Set APP_ENV=dev, test, or demo in the process environment to select a profile.
# This optional local file is ignored by Git and overrides non-profile values.
# LOG_LEVEL=INFO
# DATABASE_URL=postgresql+psycopg://localhost:5432/nianian
# AUTH_SIGNING_KEY=  # Set a locally generated random value, at least 32 characters.

# Real text LLM: APP_ENV=dev in process; keep PROVIDER_MODE=mock for DEMO login.
# DeepSeek V4.1 Flash via its official Chat Completions API.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_THINKING=disabled
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=20
# Omit LLM_THINKING for providers without the DeepSeek thinking extension.
# Other AI provider entry points remain unimplemented.
# ASR_API_KEY=
# TTS_API_KEY=
# EMBEDDING_API_KEY=
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=nianian-private
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Week 3: use the API origin reachable by clients; HTTPS outside local development.
# PUBLIC_BASE_URL=http://localhost:8000
# FILE_MAX_SIZE_BYTES=5242880
# FILE_MAX_PIXELS=12000000
# FILE_URL_SECONDS=120
# UPLOAD_EXPIRY_SECONDS=3600
# REMINDER_FEEDBACK_SECONDS=3600
# External attention delivery is disabled unless explicitly enabled in APP_ENV=dev.
NOTIFICATION_EXTERNAL_ENABLED=false
NOTIFICATION_PUSH_PROVIDER=mock
# NTFY_BASE_URL=https://your-private-ntfy.example
# PUSH_API_KEY=configure-in-local-env-only
# TWILIO_ACCOUNT_SID=configure-in-local-env-only
# TWILIO_AUTH_TOKEN=configure-in-local-env-only
# TWILIO_FROM_NUMBER=configure-in-local-env-only
# CONTACT_ENCRYPTION_KEY: generate using cryptography.fernet.Fernet.generate_key().
