# Set APP_ENV=dev, test, or demo in the process environment to select a profile.
# This optional local file is ignored by Git and overrides non-profile values.
# LOG_LEVEL=INFO
# DATABASE_URL=postgresql+psycopg://localhost:5432/nianian
# AUTH_SIGNING_KEY=  # Set a locally generated random value, at least 32 characters.

# Real text LLM: APP_ENV=dev in process; keep PROVIDER_MODE=mock for DEMO login.
# DeepSeek V4.1 Flash via its official Chat Completions API.
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_THINKING=disabled
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=20
# Omit LLM_THINKING for providers without the DeepSeek thinking extension.
# Local Chinese semantic retrieval; download the model first (docs/deployment.md).
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL_PATH=D:/niannian/artifacts/embedding/bge-small-zh-v1.5
# EMBEDDING_THREADS=2
# EMBEDDING_TIMEOUT_SECONDS=8
# EMBEDDING_MIN_RELEVANCE=0.5
# No Embedding API key is needed; runtime uses only local model files.
# Private ntfy push (optional; setup in docs/deployment.md).
# NOTIFICATION_EXTERNAL_ENABLED=false
# NOTIFICATION_PUSH_PROVIDER=ntfy
# NTFY_BASE_URL=https://your-private-push-server
# NTFY_CA_FILE=  # Optional private CA path; never disables TLS verification.
# PUSH_API_KEY=  # Server-only publishing token.
# CONTACT_ENCRYPTION_KEY=  # Keep the existing key when updating a deployment.
# Backend speech provider entry points remain unimplemented.
# ASR_API_KEY=
# TTS_API_KEY=
# Photo avatar: disabled until explicitly configured; APP_ENV=dev in API/workers.
AVATAR_GENERATION_ENABLED=false
AVATAR_IMAGE_PROVIDER=doubao
AVATAR_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AVATAR_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
# AVATAR_IMAGE_API_KEY=  # Server only; never put this in Android or Git.
# Qwen alternative (use the region/model enabled for your account):
# AVATAR_IMAGE_PROVIDER=qwen
# AVATAR_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# AVATAR_IMAGE_MODEL=qwen-image-2.0-pro
# AVATAR_IMAGE_TIMEOUT=300
# Absolute paths on the GPU worker host; setup in docs/deployment.md.
# AVATAR_THA3_PYTHON=/srv/niannian/tha3/venv/bin/python
# AVATAR_THA3_ROOT=/srv/niannian/tha3/upstream
# AVATAR_THA3_MODELS=/srv/niannian/tha3/models/separable_float
# AVATAR_FACE_CASCADE=/srv/niannian/tha3/preprocess/lbpcascade_animeface.xml
# AVATAR_REMBG_MODELS=/srv/niannian/tha3/preprocess
# AVATAR_RENDER_TIMEOUT=300
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=nianian-private
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Week 3: use the API origin reachable by clients; HTTPS outside local development.
# PUBLIC_BASE_URL=http://localhost:8000
# FILE_MAX_SIZE_BYTES=5242880
# FILE_MAX_PIXELS=12000000
# FILE_URL_SECONDS=120
# UPLOAD_EXPIRY_SECONDS=3600
# REMINDER_FEEDBACK_SECONDS=3600
# External attention delivery is disabled unless explicitly enabled in APP_ENV=dev.
NOTIFICATION_EXTERNAL_ENABLED=false
NOTIFICATION_PUSH_PROVIDER=mock
# NTFY_BASE_URL=https://your-private-ntfy.example
# PUSH_API_KEY=configure-in-local-env-only
# TWILIO_ACCOUNT_SID=configure-in-local-env-only
# TWILIO_AUTH_TOKEN=configure-in-local-env-only
# TWILIO_FROM_NUMBER=configure-in-local-env-only
# CONTACT_ENCRYPTION_KEY: generate using cryptography.fernet.Fernet.generate_key().
# Account lifecycle: only explicitly managed backup files are pruned.
BACKUP_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
TASK_RETENTION_DAYS=7
ACCOUNT_EXPORT_MAX_BYTES=104857600
# BACKUP_DIRECTORY=/srv/niannian/backups

# Family voices: real calls require APP_ENV=dev; never put keys in source control.
FAMILY_VOICE_ENABLED=false
# FAMILY_VOICE_WORKSPACE_ID=your-beijing-workspace-id
# FAMILY_VOICE_API_KEY=configure-in-local-env-only
